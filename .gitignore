.DS_Store
.hubenv/
__pycache__/
*.pyc
registry.json
hub.log

# runtime state (registry.json is the one that matters: it holds the user's
# registered projects, folders and commands, and must never be published)
.hubstate/

# packaging output
build/
dist/
release-assets/
*.egg-info/
.venv/
.buildenv/

# Secrets stay local; only a credential-free example may be committed.
.env
.env.*
!.env.example
